{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=OfficeAssistantDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },

  "JwtSettings": {
    "Issuer": "OfficeAssistant.API",
    "Audience": "OfficeAssistant.Web",
    "ExpirationMinutes": 120
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "Gemini": {
    "Model": "gemini-flash-latest",
    "RequestsPerMinute": 6,
    "DailyRequestLimit": 100
  },

  "AllowedHosts": "*"
}